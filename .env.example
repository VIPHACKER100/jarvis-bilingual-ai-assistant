# ============================================================
#  JARVIS — Bilingual AI Assistant
#  Environment Variables — Copy this file to .env and fill in
# ============================================================

# ── PRIMARY AI BACKEND: OpenRouter (recommended) ─────────────
# Get your free key at: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here

# Model to use via OpenRouter
# Free options: nvidia/nemotron-3-super-120b-a12b:free
#               meta-llama/llama-3.3-8b-instruct:free
#               mistralai/mistral-7b-instruct:free
VITE_MODEL_NAME=nvidia/nemotron-3-super-120b-a12b:free

# ── FALLBACK AI BACKEND: Google Gemini ───────────────────────
# Get your free key at: https://aistudio.google.com/apikey
# Used automatically if VITE_OPENROUTER_API_KEY is not set
VITE_GEMINI_API_KEY=AIzaSy-your_gemini_key_here

# ============================================================
#  NOTES
#  - Never commit your real .env file to version control
#  - OpenRouter key takes priority over Gemini key
#  - Both keys are optional — the app works without them
#    using built-in command handlers (navigation, time, etc.)
# ============================================================
